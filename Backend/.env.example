# Copy this file to .env and fill in your own values. Never commit .env.

# --- Required ---
# Groq API key (create one at https://console.groq.com/keys). The variable keeps the OPENAI_ prefix
# because the OpenAI SDK is used as a client for Groq's OpenAI-compatible API.
OPENAI_API_KEY=your_groq_api_key_here
MONGODB_URI=mongodb://127.0.0.1:27017/sigmagpt

# --- Server ---
PORT=8080
# Comma-separated list of browser origins allowed to call the API
FRONTEND_ORIGIN=http://localhost:5173
# How long to wait for MongoDB at start-up before exiting with an error
DB_CONNECT_TIMEOUT_MS=5000

# --- AI model (served by Groq) ---
OPENAI_MODEL=openai/gpt-oss-20b
# Abort a model request after this many milliseconds (returns HTTP 504)
OPENAI_TIMEOUT_MS=30000
# Automatic retries for transient provider errors
OPENAI_MAX_RETRIES=1
# Optional generation settings (leave empty to use the model defaults)
OPENAI_TEMPERATURE=
OPENAI_MAX_OUTPUT_TOKENS=
# Optional override of the API base URL. Leave empty to use Groq (https://api.groq.com/openai/v1).
# The automated tests set it to a local mock server.
OPENAI_BASE_URL=

# --- Conversation context ---
# Maximum number of recent messages sent to the model
CONTEXT_MAX_MESSAGES=20
# Character budget for those messages (about 4 characters per token)
CONTEXT_MAX_CHARS=24000

# --- Request limits ---
MAX_MESSAGE_CHARS=8000
BODY_LIMIT=100kb
# Chat requests allowed per client IP per window
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000

# --- Tests only (npm test) ---
# A separate database used by the integration tests; it is emptied during the tests.
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/sigmagpt_test
